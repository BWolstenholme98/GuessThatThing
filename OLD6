<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Guess That Thing</title>
<style>
/* ── BAIN DESIGN SYSTEM TOKENS (verbatim) ─────────────────────────────────── */
:root {
  --ds-space-01: 2px;
  --ds-space-02: 4px;
  --ds-space-03: 8px;
  --ds-space-04: 16px;
  --ds-space-05: 24px;
  --ds-space-06: 32px;
  --ds-space-07: 40px;
  --ds-space-08: 48px;
  --ds-space-09: 64px;
  --ds-space-10: 80px;
  --ds-space-11: 96px;
  --ds-space-12: 160px;
  --ds-font-sans: Arial, Helvetica, sans-serif;
  --ds-color-company-red:       #CC0000;
  --ds-color-company-red-hover: #9D1B22;
  --ds-color-black:             #121212;
  --ds-color-white:             #FFFFFF;
  --ds-text-black:    #000000;
  --ds-text-dark:     #333333;
  --ds-text-regular:  #717171;
  --ds-text-body:     #616568;
  --ds-text-helper:   #767676;
  --ds-text-on-color: #FFFFFF;
  --ds-gray-x-light:  #F9F9F9;
  --ds-gray-light:    #ECECEC;
  --ds-gray-medium:   #CCCCCC;
  --ds-gray-dark:     #A3A3A3;
  --ds-stroke:        #D8D8D8;
  --ds-success:       #07C29F;
  --ds-success-light: #DAF2ED;
  --ds-warning:       #F1C21B;
  --ds-warning-light: #FEF7E8;
  --ds-error:         #CC0000;
  --ds-error-light:   #F2DFD8;
  --ds-background:        var(--ds-color-white);
  --ds-background-hover:  rgba(0,0,0,0.04);
  --ds-layer-tinted:      var(--ds-gray-x-light);
  --ds-shadow-card:       0 14px 42px 0 rgba(8,15,52,0.06);
  --ds-nav-height: 0;
  --ds-red-100: #FF6666;
  --ds-red-200: #CC0000;
  --ds-red-300: #990000;
  --ds-red-400: #660000;
  --ds-chart-gray-100: #D2D2D1;
  --ds-chart-gray-200: #A5A5A4;
  --ds-surface:          var(--ds-color-white);
  --ds-surface-text:     var(--ds-text-dark);
  --ds-surface-heading:  var(--ds-text-black);
  --ds-surface-divider:  var(--ds-stroke);
  --ds-surface-eyebrow:  var(--ds-color-company-red);
}
html, body {
  font-family: var(--ds-font-sans);
  color: var(--ds-surface-text);
  background: var(--ds-surface);
  margin: 0;
  font-size: 16px;
  line-height: 24px;
}

/* ── RESET ───────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }
h1,h2,h3,h4,p { margin: 0; }
button { font-family: var(--ds-font-sans); cursor: pointer; }
input, textarea { font-family: var(--ds-font-sans); }
a { color: var(--ds-color-company-red); text-underline-offset: 2px; }
a:hover { color: var(--ds-color-company-red-hover); }

/* ── SCREENS ─────────────────────────────────────────────────────────────── */
.screen { display: none; min-height: 100vh; flex-direction: column; }
.screen.active { display: flex; }

/* ── LAYOUT ──────────────────────────────────────────────────────────────── */
.page-wrap    { max-width: 880px; margin: 0 auto; padding: var(--ds-space-06) var(--ds-space-05); width: 100%; }
.page-wrap-sm { max-width: 560px; margin: 0 auto; padding: var(--ds-space-06) var(--ds-space-05); width: 100%; }
.page-wrap-md { max-width: 680px; margin: 0 auto; padding: var(--ds-space-06) var(--ds-space-05); width: 100%; }
.page-centre  { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: var(--ds-space-07) var(--ds-space-05); text-align: center; }
.flex         { display: flex; }
.flex-col     { flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.gap-2  { gap: var(--ds-space-02); }
.gap-3  { gap: var(--ds-space-03); }
.gap-4  { gap: var(--ds-space-04); }
.gap-5  { gap: var(--ds-space-05); }
.gap-6  { gap: var(--ds-space-06); }
.mt-3   { margin-top: var(--ds-space-03); }
.mt-4   { margin-top: var(--ds-space-04); }
.mt-5   { margin-top: var(--ds-space-05); }
.mt-6   { margin-top: var(--ds-space-06); }
.mt-7   { margin-top: var(--ds-space-07); }
.mb-4   { margin-bottom: var(--ds-space-04); }
.mb-5   { margin-bottom: var(--ds-space-05); }

/* ── TOP BAR (nav) ───────────────────────────────────────────────────────── */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--ds-space-04) var(--ds-space-05);
  border-bottom: 1px solid var(--ds-stroke);
  background: var(--ds-color-white);
  flex-shrink: 0;
}
.topbar-logo {
  font-size: 16px; font-weight: 700; color: var(--ds-text-black);
  letter-spacing: 0; text-transform: uppercase;
}
.topbar-logo span { color: var(--ds-color-company-red); }

/* Red accent bar under topbar */
.red-bar { height: 4px; background: var(--ds-color-company-red); flex-shrink: 0; }

/* ── EYEBROW ─────────────────────────────────────────────────────────────── */
.eyebrow {
  font-size: 11px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--ds-surface-eyebrow);
  margin-bottom: var(--ds-space-02);
}

/* ── TYPOGRAPHY ──────────────────────────────────────────────────────────── */
.h1 { font-size: 40px; font-weight: 700; line-height: 48px; color: var(--ds-text-black); }
.h2 { font-size: 28px; font-weight: 700; line-height: 36px; color: var(--ds-text-black); }
.h3 { font-size: 21px; font-weight: 700; line-height: 28px; color: var(--ds-text-black); }
.h4 { font-size: 16px; font-weight: 700; line-height: 24px; color: var(--ds-text-dark); }
.body-lg { font-size: 18px; line-height: 28px; color: var(--ds-text-dark); }
.body    { font-size: 16px; line-height: 24px; color: var(--ds-text-dark); }
.body-sm { font-size: 14px; line-height: 20px; color: var(--ds-text-regular); }
.caption { font-size: 12px; line-height: 18px; color: var(--ds-text-regular); }
.text-red   { color: var(--ds-color-company-red); }
.text-muted { color: var(--ds-text-regular); }
.text-center { text-align: center; }
.block { display: block; }

/* ── BUTTONS ─────────────────────────────────────────────────────────────── */
.ds-btn {
  font-family: var(--ds-font-sans);
  font-size: 14px; font-weight: 700; line-height: 16px;
  text-transform: uppercase; letter-spacing: 0;
  padding: var(--ds-space-05) var(--ds-space-06);
  border: 1px solid transparent; border-radius: 0;
  cursor: pointer; transition: background 120ms, color 120ms, border-color 120ms;
  display: inline-flex; align-items: center; justify-content: center; gap: var(--ds-space-03);
  min-height: 56px; text-decoration: none;
}
.ds-btn--red   { background: var(--ds-color-company-red); color: var(--ds-text-on-color); }
.ds-btn--red:hover { background: var(--ds-color-company-red-hover); }
.ds-btn--white { background: var(--ds-color-white); color: var(--ds-color-company-red); border-color: var(--ds-stroke); }
.ds-btn--white:hover { background: var(--ds-color-company-red-hover); color: var(--ds-text-on-color); border-color: var(--ds-color-company-red-hover); }
.ds-btn--ghost { background: transparent; color: var(--ds-text-regular); border-color: var(--ds-stroke); }
.ds-btn--ghost:hover { border-color: var(--ds-text-dark); color: var(--ds-text-dark); }
.ds-btn--block { width: 100%; }
.ds-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.ds-btn:disabled:hover { background: var(--ds-color-company-red); }
.ds-btn--white:disabled:hover { background: var(--ds-color-white); color: var(--ds-color-company-red); }
.ds-btn--ghost:disabled:hover { background: transparent; color: var(--ds-text-regular); border-color: var(--ds-stroke); }
.ds-btn:focus-visible { outline: 2px solid var(--ds-color-company-red); outline-offset: 2px; }

/* Pill button (for secondary/inline actions) */
.ds-btn--pill {
  font-size: 14px; font-weight: 700; line-height: 20px;
  text-transform: none; padding: var(--ds-space-02) var(--ds-space-04);
  border-radius: 45px; border: 1px solid var(--ds-stroke);
  background: var(--ds-color-white); color: var(--ds-text-dark);
  min-height: 32px; cursor: pointer; transition: all 120ms;
  display: inline-flex; align-items: center; gap: var(--ds-space-02);
}
.ds-btn--pill:hover { border-color: var(--ds-color-company-red); color: var(--ds-color-company-red); }

/* ── INPUTS ──────────────────────────────────────────────────────────────── */
.ds-label { display: block; font-weight: 700; font-size: 14px; line-height: 20px; color: var(--ds-text-dark); margin-bottom: var(--ds-space-02); }
.ds-input {
  font-family: var(--ds-font-sans); font-size: 16px; line-height: 24px;
  padding: 12px var(--ds-space-03);
  background: var(--ds-gray-x-light); color: var(--ds-text-dark);
  border: 1px solid var(--ds-color-black); border-radius: 0;
  width: 100%; height: 48px; box-sizing: border-box;
}
.ds-input::placeholder { color: var(--ds-text-regular); }
.ds-input:focus { background: var(--ds-color-white); box-shadow: 0 0 0 3px var(--ds-text-regular); outline: 2px solid transparent; }
textarea.ds-input { height: auto; min-height: 80px; resize: vertical; }

/* ── CARDS ───────────────────────────────────────────────────────────────── */
.ds-card {
  background: var(--ds-color-white); border: 1px solid var(--ds-stroke);
  padding: var(--ds-space-05); box-shadow: var(--ds-shadow-card);
}
.ds-card--quiet { background: var(--ds-gray-x-light); border: 1px solid var(--ds-stroke); padding: var(--ds-space-05); box-shadow: none; }

/* ── DIVIDER ─────────────────────────────────────────────────────────────── */
.ds-divider { border: none; border-top: 1px solid var(--ds-stroke); margin: var(--ds-space-05) 0; }

/* ── PROGRESS (submission bar) ───────────────────────────────────────────── */
.ds-progress { width: 100%; height: 4px; background: var(--ds-stroke); }
.ds-progress__fill { height: 100%; background: var(--ds-color-company-red); transition: width 300ms ease-out; }

/* ── NOTIFICATION ────────────────────────────────────────────────────────── */
.ds-notification { display: flex; gap: var(--ds-space-03); padding: var(--ds-space-04); border-left: 3px solid; font-size: 14px; line-height: 20px; color: var(--ds-text-dark); }
.ds-notification--success { background: var(--ds-success-light); border-color: var(--ds-success); }
.ds-notification--error   { background: var(--ds-error-light);   border-color: var(--ds-error); }

/* ── BADGE / STATUS TAG ──────────────────────────────────────────────────── */
.badge {
  display: inline-block; padding: 2px 10px;
  font-size: 12px; font-weight: 700; line-height: 18px;
  background: var(--ds-gray-x-light); color: var(--ds-text-regular);
  border: 1px solid var(--ds-stroke);
}
.badge--red   { background: var(--ds-error-light); color: var(--ds-color-company-red); border-color: var(--ds-color-company-red); }
.badge--green { background: var(--ds-success-light); color: var(--ds-success); border-color: var(--ds-success); }

/* ── TOAST ───────────────────────────────────────────────────────────────── */
#toast {
  position: fixed; bottom: var(--ds-space-06); left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: var(--ds-text-dark); color: var(--ds-text-on-color);
  padding: var(--ds-space-03) var(--ds-space-05);
  font-size: 14px; font-weight: 700;
  z-index: 9999; white-space: nowrap;
  border-left: 4px solid var(--ds-color-company-red);
  box-shadow: var(--ds-shadow-card);
  transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
}
#toast.show { transform: translateX(-50%) translateY(0); }

/* ── LOADING OVERLAY ─────────────────────────────────────────────────────── */
#loading {
  display: none; position: fixed; inset: 0;
  background: rgba(255,255,255,0.92);
  z-index: 1000; align-items: center; justify-content: center; flex-direction: column; gap: var(--ds-space-04);
}
#loading.show { display: flex; }
.spinner { width: 40px; height: 40px; border: 3px solid var(--ds-stroke); border-top-color: var(--ds-color-company-red); border-radius: 50%; animation: spin 0.8s linear infinite; }
#loading-text { font-size: 14px; font-weight: 700; color: var(--ds-text-regular); text-transform: uppercase; letter-spacing: 0.05em; }

/* ── OVERLAYS ────────────────────────────────────────────────────────────── */
.overlay { display: none; position: fixed; inset: 0; background: rgba(18,18,18,0.5); z-index: 2000; align-items: center; justify-content: center; padding: var(--ds-space-05); }
.overlay.show { display: flex; }
.modal { background: var(--ds-color-white); border-top: 4px solid var(--ds-color-company-red); padding: var(--ds-space-06); max-width: 440px; width: 100%; box-shadow: var(--ds-shadow-card); }

/* ── AVATAR ──────────────────────────────────────────────────────────────── */
.avatar { border-radius: 50%; object-fit: cover; flex-shrink: 0; display: block; }
.avatar-init { border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--ds-text-on-color); }

/* ── PLAYER GRID (setup) ─────────────────────────────────────────────────── */
.player-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--ds-space-03); }
.player-tile {
  display: flex; flex-direction: column; align-items: center; gap: var(--ds-space-03);
  padding: var(--ds-space-04) var(--ds-space-03);
  background: var(--ds-gray-x-light); border: 2px solid var(--ds-stroke);
  cursor: pointer; transition: all 120ms; position: relative;
  font-size: 14px; font-weight: 700; color: var(--ds-text-dark);
}
.player-tile:hover { border-color: var(--ds-color-company-red); }
.player-tile.sel  { background: var(--ds-error-light); border-color: var(--ds-color-company-red); color: var(--ds-color-company-red); }
.player-tile .tick { position: absolute; top: 6px; right: 6px; width: 18px; height: 18px; background: var(--ds-color-company-red); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.player-tile .tick svg { width: 10px; height: 10px; fill: var(--ds-text-on-color); }

/* ── SUBMISSION STATUS ROW ───────────────────────────────────────────────── */
.sub-row { display: flex; align-items: center; gap: var(--ds-space-03); padding: var(--ds-space-02) 0; border-bottom: 1px solid var(--ds-stroke); }
.sub-row:last-child { border-bottom: none; }

/* ── ROOM CODE ───────────────────────────────────────────────────────────── */
.room-code-display {
  font-size: 36px; font-weight: 700; letter-spacing: 0.18em;
  color: var(--ds-text-black); text-align: center;
  padding: var(--ds-space-05) var(--ds-space-06);
  background: var(--ds-gray-x-light); border: 1px solid var(--ds-stroke);
  border-left: 4px solid var(--ds-color-company-red);
  cursor: pointer; transition: background 120ms; user-select: all;
}
.room-code-display:hover { background: var(--ds-error-light); }

/* ── QUESTION CARD ───────────────────────────────────────────────────────── */
.question-text {
  font-size: 22px; font-weight: 700; line-height: 32px;
  color: var(--ds-text-black); padding: var(--ds-space-05);
  border-left: 4px solid var(--ds-color-company-red);
  background: var(--ds-gray-x-light);
}

/* ── FLIP CARD ───────────────────────────────────────────────────────────── */
.flip-wrap { perspective: 1200px; cursor: pointer; flex: 1 1 280px; min-width: 260px; max-width: 400px; height: 200px; }
.flip-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.65s cubic-bezier(0.4,0.2,0.2,1); }
.flip-wrap.flipped .flip-inner { transform: rotateY(180deg); }
.flip-face { position: absolute; inset: 0; backface-visibility: hidden; overflow: hidden; }
.flip-front { background: var(--ds-color-white); border: 1px solid var(--ds-stroke); border-top: 3px solid var(--ds-color-company-red); display: flex; box-shadow: var(--ds-shadow-card); }
.flip-back  { background: var(--ds-gray-x-light); border: 1px solid var(--ds-color-company-red); border-top: 3px solid var(--ds-color-company-red); transform: rotateY(180deg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--ds-space-03); }
.card-text-half { flex: 1; padding: var(--ds-space-04); display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.card-img-half  { width: 130px; flex-shrink: 0; }
.card-img-half img, .card-img-half svg { width: 100%; height: 100%; object-fit: cover; display: block; }

/* ── SVG ART ─────────────────────────────────────────────────────────────── */
.svg-art-wrap { width: 100%; height: 100%; }

/* ── Q OPTION LIST ───────────────────────────────────────────────────────── */
.q-option {
  display: block; width: 100%; text-align: left;
  background: var(--ds-gray-x-light); border: 1px solid var(--ds-stroke); border-left: 3px solid transparent;
  padding: var(--ds-space-04); font-family: var(--ds-font-sans);
  font-size: 15px; line-height: 22px; color: var(--ds-text-dark);
  cursor: pointer; transition: all 120ms;
}
.q-option:hover { border-left-color: var(--ds-color-company-red); background: var(--ds-error-light); color: var(--ds-color-company-red); }

/* ── ROSTER ROW ──────────────────────────────────────────────────────────── */
.roster-row { display: flex; align-items: center; gap: var(--ds-space-04); padding: var(--ds-space-04); border-bottom: 1px solid var(--ds-stroke); }
.roster-row:last-child { border-bottom: none; }

/* ── SETUP STEP ──────────────────────────────────────────────────────────── */
.setup-step { display: flex; gap: var(--ds-space-04); align-items: flex-start; padding: var(--ds-space-04) 0; border-bottom: 1px solid var(--ds-stroke); }
.setup-step:last-child { border-bottom: none; }
.step-num { width: 28px; height: 28px; background: var(--ds-color-company-red); color: var(--ds-text-on-color); font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }

/* ── CONFETTI ────────────────────────────────────────────────────────────── */
.confetti-piece { position: fixed; pointer-events: none; z-index: 9000; animation: confettiFall linear forwards; }

/* ── ANIMATIONS ──────────────────────────────────────────────────────────── */
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes confettiFall { 0% { transform: translateY(-20px) rotate(0); opacity: 1; } 100% { transform: translateY(110vh) rotate(720deg); opacity: 0; } }
@keyframes slideUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeIn  { from { opacity: 0; } to { opacity: 1; } }

/* ── PRINT HIDE ──────────────────────────────────────────────────────────── */
@media print { .ds-progress, #toast, #loading { display: none; } }
</style>
</head>
<body>

<!-- TOAST -->
<div id="toast"></div>

<!-- LOADING -->
<div id="loading"><div class="spinner"></div><div id="loading-text">Loading…</div></div>

<!-- CONFIRM MODAL -->
<div id="confirm-overlay" class="overlay">
  <div class="modal">
    <p class="h4" style="margin-bottom:var(--ds-space-04);" id="confirm-msg"></p>
    <div class="flex gap-3">
      <button class="ds-btn ds-btn--ghost" onclick="confirmCancel()">Cancel</button>
      <button class="ds-btn ds-btn--red" id="confirm-ok">Confirm</button>
    </div>
  </div>
</div>

<!-- MEMBER EDITOR MODAL -->
<div id="member-overlay" class="overlay">
  <div class="modal">
    <p class="h4" id="member-title" style="margin-bottom:var(--ds-space-05);">Add team member</p>
    <div style="display:flex;flex-direction:column;align-items:center;gap:var(--ds-space-03);margin-bottom:var(--ds-space-05);">
      <div style="position:relative;cursor:pointer;" onclick="document.getElementById('photo-file').click()">
        <div id="modal-av" style="width:72px;height:72px;"></div>
        <div style="position:absolute;bottom:0;right:0;width:22px;height:22px;background:var(--ds-color-company-red);display:flex;align-items:center;justify-content:center;">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="white"><path d="M8 4a2 2 0 0 0-2 2v.5H4.5A1.5 1.5 0 0 0 3 8v5a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 15 13V8a1.5 1.5 0 0 0-1.5-1.5H12V6a2 2 0 0 0-2-2H8zm0 1.5h2a.5.5 0 0 1 .5.5v.5H7.5V6a.5.5 0 0 1 .5-.5zM9 9.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
        </div>
      </div>
      <input type="file" id="photo-file" accept="image/*" style="display:none" onchange="onPhotoFile(event)">
      <button id="photo-btn" onclick="document.getElementById('photo-file').click()" class="ds-btn--pill">Upload photo</button>
      <button id="rm-photo-btn" onclick="removePhoto()" style="display:none;background:none;border:none;color:var(--ds-color-company-red);font-size:13px;cursor:pointer;font-family:var(--ds-font-sans);">Remove photo</button>
    </div>
    <div style="margin-bottom:var(--ds-space-04);">
      <label class="ds-label" for="modal-name">Name</label>
      <input type="text" class="ds-input" id="modal-name" placeholder="First name" maxlength="30" onkeydown="if(event.key==='Enter')saveMember()">
    </div>
    <div class="flex gap-3">
      <button class="ds-btn ds-btn--ghost" onclick="closeMemberModal()" style="flex:1;">Cancel</button>
      <button class="ds-btn ds-btn--red" onclick="saveMember()" style="flex:1;">Save</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: FIREBASE SETUP
══════════════════════════════════════════════════════════ -->
<div id="screen-firebase" class="screen active">
  <div class="topbar"><span class="topbar-logo">Guess That <span>Thing</span></span></div>
  <div class="red-bar"></div>
  <div class="page-centre">
    <div style="max-width:520px;width:100%;">
