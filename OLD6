// On-brand SVG: red + grey geometric pattern, no bright candy colors
function svgArt(emoji,idx){
  const fills=['#CC0000','#9D1B22','#F9F9F9','#ECECEC','#D2D2D1'];
  const f=fills[idx%fills.length];
  const gl=[...(emoji||'🎭')].slice(0,4);
  const pos=[{x:50,y:38},{x:50,y:72},{x:26,y:55},{x:74,y:55}];
  const fs=gl.length===1?36:gl.length===2?26:20;
  const dots=[15,35,55,75,95].flatMap(x=>[20,50,80].map(y=>`<circle cx="${x}" cy="${y}" r="1" fill="${f==='#F9F9F9'?'#CCCCCC':'rgba(255,255,255,0.2)"}"/>`)).join('');
  const txts=gl.map((g,i)=>`<text x="${pos[i]?.x??50}" y="${pos[i]?.y??50}" text-anchor="middle" dominant-baseline="middle" font-size="${fs}" style="user-select:none">${g}</text>`).join('');
  const bg=idx%2===0?'#CC0000':'#333333';
  return`<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;"><rect width="100" height="100" fill="${bg}"/><rect x="0" y="0" width="100" height="4" fill="rgba(0,0,0,0.3)"/>${dots}${txts}</svg>`;
}

function localEmojiArt(answer){
  const lo=answer.toLowerCase();
  const maps=[[/\b(music|album|band|song|guitar|piano|drum|sing|concert|vinyl)\b/,'🎵🎸🎤🎶'],[/\b(film|movie|cinema|actor|direct|hollywood|netflix|watch)\b/,'🎬🎥🍿🎞️'],[/\b(book|read|novel|author|write|story|fiction)\b/,'📚📖✍️🖊️'],[/\b(food|eat|cook|chef|restaurant|meal|recipe|taste)\b/,'🍽️👨‍🍳🥘'],[/\b(travel|trip|country|city|flight|beach|mountain|hotel)\b/,'✈️🌍🗺️🧳'],[/\b(sport|run|gym|football|tennis|swim|cycling|fitness)\b/,'🏃⚽🎾🏋️'],[/\b(tech|code|software|app|data|compute|ai|digital)\b/,'💻🤖⌨️🔧'],[/\b(space|star|planet|astronaut|rocket|galaxy)\b/,'🚀🌟🪐🌌'],[/\b(game|chess|poker|board|video|rpg|puzzle)\b/,'🎮♟️🎲🏆'],[/\b(coffee|cafe|espresso|latte|brew)\b/,'☕🫘🧋'],[/\b(wine|beer|cocktail|bar|whisky|gin|champagne)\b/,'🍷🍺🍸🥂']];
  for(const[rx,art]of maps)if(rx.test(lo))return art;
  const s={'a':'⭐🎯','b':'💡🔮','c':'☀️💎','d':'🎭🌙','e':'🌿🎨','f':'🔥⚡','g':'💚🌿','h':'🏔️🌅','i':'💡⭐','j':'🎸🎵','k':'🔑💫','l':'❤️💫','m':'🌙⭐','n':'🌙⭐','o':'🌊💫','p':'🎨💫','q':'🔮⭐','r':'🌹❤️','s':'⭐💫','t':'🌿🎯','u':'☂️💫','v':'💫⭐','w':'🌊💫','x':'💫⭐','y':'💛💫','z':'⚡💫'};
  return s[lo[0]]||'🎭✨';
}

function mediaHTML(cover,emoji,idx){
  if(cover?.type==='image'&&cover.url)return`<img src="${cover.url}" alt="" onerror="this.outerHTML='${svgArt(emoji,idx).replace(/'/g,"&#39;")}'" style="width:100%;height:100%;object-fit:cover;display:block;">`;
  return svgArt(emoji,idx);
}

