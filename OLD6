// ═══════════════════════════════════════════════════════════
//  COVER ART FALLBACK
// ═══════════════════════════════════════════════════════════
async function fetchCover(ans){
  const lo=ans.toLowerCase();
  const hasAlbumKw=/\b(album|record|lp|ep|mixtape|vinyl|discography)\b/.test(lo);
  const hasMusicKw=/\b(by |from |artist |band |singer |rapper )/.test(lo);
  const hasMovieKw=/\b(film|movie|series|show|documentary|directed by)\b/.test(lo);
  const hasBookKw=/\b(book|novel|memoir|biography|by )/.test(lo);
  const hasPodKw=/\b(podcast)\b/.test(lo);
  const term=ans.replace(/\b(the|a|an|by|from|with|my fav(ou?rite)?|probably|definitely|honestly|something like|i('d| would| think)( go with| pick| say| choose)?)\b/gi,'').replace(/\b(album|record|lp|ep|mixtape|vinyl|film|movie|series|show|documentary|book|novel|memoir|biography|podcast)\b/gi,'').trim().slice(0,80);
  if(term.length<4)return{type:'svg'};
  const isVague=/^(jazz|rock|pop|hip.?hop|classical|country|r&b|soul|electronic|techno|house|metal|punk|indie|folk|blues|reggae|latin)$/i.test(term.trim());
  const isCuisine=/^(italian|french|japanese|chinese|indian|mexican|thai|spanish|greek|korean|vietnamese|turkish|moroccan|sushi|pasta|pizza|curry|ramen|tacos)$/i.test(term.trim());
  const isActivity=/^(cooking|reading|writing|running|cycling|swimming|hiking|gaming|drawing|painting|photography|yoga|dancing|singing|coding)$/i.test(term.trim());
  if(isVague||isCuisine||isActivity)return{type:'svg'};
  const doMusic=hasAlbumKw||hasMusicKw,doMovie=hasMovieKw,doBook=hasBookKw,doPod=hasPodKw;
  if(!doMusic&&!doMovie&&!doBook&&!doPod)return{type:'svg'};
  try{
    if(doMusic||doPod){
      const entity=doPod?'podcast':'album',media=doPod?'podcast':'music';
      const r=await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(term)}&entity=${entity}&limit=3&media=${media}`);
      const d=await r.json();
      if(d.results?.length){const top=d.results[0];const rn=(top.collectionName||top.trackName||'').toLowerCase();const tw=term.toLowerCase().split(/\s+/).filter(w=>w.length>2);const mc=tw.filter(w=>rn.includes(w)).length;if(mc>=Math.max(1,Math.floor(tw.length*0.5))){const art=(top.artworkUrl100||'').replace('100x100bb','400x400bb');if(art)return{type:'image',url:art};}}
    }
    if(doMovie){
      const r=await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(term)}&entity=movie&limit=3&media=movie`);
      const d=await r.json();
      if(d.results?.length){const top=d.results[0];const rn=(top.trackName||'').toLowerCase();const tw=term.toLowerCase().split(/\s+/).filter(w=>w.length>2);const mc=tw.filter(w=>rn.includes(w)).length;if(mc>=Math.max(1,Math.floor(tw.length*0.5))){const art=(top.artworkUrl100||'').replace('100x100bb','400x400bb');if(art)return{type:'image',url:art};}}
    }
    if(doBook){
      const r=await fetch(`https://openlibrary.org/search.json?q=${encodeURIComponent(term)}&limit=3&fields=title,cover_i`);
      const d=await r.json();
      if(d.docs?.length){const top=d.docs[0];const rn=(top.title||'').toLowerCase();const tw=term.toLowerCase().split(/\s+/).filter(w=>w.length>2);const mc=tw.filter(w=>rn.includes(w)).length;if(mc>=Math.max(1,Math.floor(tw.length*0.5))&&top.cover_i)return{type:'image',url:`https://covers.openlibrary.org/b/id/${top.cover_i}-L.jpg`};}
    }
  }catch{}
  return{type:'svg'};
}

