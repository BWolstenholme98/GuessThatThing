// Uses company red + neutral dark to stay on-brand
const GRAD_PAIRS=[
  ['#CC0000','#9D1B22'],['#333333','#121212'],['#990000','#660000'],
  ['#717171','#333333'],['#A3A3A3','#717171'],['#CC0000','#333333'],
];

// ═══════════════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════════════
let roster=[],selIds=[],roomCode=null,question='',activePlayers=[],submissions={},cards=[],selectedPlayer=null;
let firebaseUrl='',sseSource=null,pollTimer=null;
let editMemberId=null,modalPhoto=null,confirmCb=null;
let displayedQIds=[];

// ═══════════════════════════════════════════════════════════
//  LOCALSTORAGE
// ═══════════════════════════════════════════════════════════
function ls(k,v){if(v===undefined){try{const r=localStorage.getItem(k);return r?JSON.parse(r):null;}catch{return null;}}else{try{localStorage.setItem(k,JSON.stringify(v));}catch{}}}
function loadRoster(){roster=ls('gtt-roster')||[];}
function saveRoster(){ls('gtt-roster',roster);}
function getFirebaseUrl(){return localStorage.getItem('gtt-firebase')||'';}

// ═══════════════════════════════════════════════════════════
//  FIREBASE
// ═══════════════════════════════════════════════════════════
function fbUrl(p){return`${firebaseUrl}/${p}.json`;}
async function fbGet(p){const r=await fetch(fbUrl(p));if(!r.ok)throw new Error('FB '+r.status);return r.json();}
async function fbPut(p,d){const r=await fetch(fbUrl(p),{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});if(!r.ok)throw new Error('FB PUT '+r.status);return r.json();}
async function fbPatch(p,d){const r=await fetch(fbUrl(p),{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});if(!r.ok)throw new Error('FB PATCH '+r.status);return r.json();}

function startSSE(code){
  stopAll();
  try{
    sseSource=new EventSource(`${firebaseUrl}/games/${code}.json?stream=true`);
    sseSource.addEventListener('put',e=>{try{const d=JSON.parse(e.data);if(d&&d.data)onRemoteUpdate(d.data);}catch{}});
    sseSource.addEventListener('patch',e=>{try{const d=JSON.parse(e.data);if(d&&d.data)onRemoteUpdate(d.data);}catch{}});
    sseSource.onerror=()=>{stopSSE();startPolling(code);};
  }catch{startPolling(code);}
}
function stopSSE(){if(sseSource){sseSource.close();sseSource=null;}}
function startPolling(code){
  stopPolling();
  pollTimer=setInterval(async()=>{try{const d=await fbGet(`games/${code}`);if(d)onRemoteUpdate(d);}catch{}},3000);
}
function stopPolling(){if(pollTimer){clearInterval(pollTimer);pollTimer=null;}}
