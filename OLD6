  const chip=document.getElementById('sub-chip');chip.textContent=`${done} / ${total}`;
  chip.className=done===total?'badge badge--green':'badge';
  document.getElementById('sub-bar').style.width=`${total?(done/total)*100:0}%`;
  // submission rows
  const sn=document.getElementById('sub-names');sn.innerHTML='';
  activePlayers.forEach(p=>{
    const isDone=!!submissions[p.id];
    const row=document.createElement('div');row.className='sub-row';
    const av=mkAvatar(p,32,`opacity:${isDone?1:.5};`);row.appendChild(av);
    const lb=document.createElement('span');lb.style.cssText='flex:1;font-size:14px;font-weight:700;color:var(--ds-text-dark);';lb.textContent=p.name;row.appendChild(lb);
    if(isDone){const ok=document.createElement('span');ok.style.cssText='font-size:13px;color:var(--ds-success);font-weight:700;';ok.textContent='Submitted ✓';row.appendChild(ok);}
    else{const pending=document.createElement('span');pending.style.cssText='font-size:13px;color:var(--ds-text-regular);';pending.textContent='Waiting…';row.appendChild(pending);}
    sn.appendChild(row);
  });
  // submit picker
  const sp=document.getElementById('submit-picker');sp.innerHTML='';
  activePlayers.forEach(p=>{
    const isDone=!!submissions[p.id];
    const btn=document.createElement('button');
    btn.style.cssText=`display:flex;flex-direction:column;align-items:center;gap:var(--ds-space-02);padding:var(--ds-space-03) var(--ds-space-04);background:${isDone?'var(--ds-success-light)':'var(--ds-gray-x-light)'};border:1px solid ${isDone?'var(--ds-success)':'var(--ds-stroke)'};cursor:pointer;font-family:var(--ds-font-sans);transition:all 120ms;`;
    btn.appendChild(mkAvatar(p,40));
    const lb=document.createElement('span');lb.style.cssText=`font-size:12px;font-weight:700;color:${isDone?'var(--ds-success)':'var(--ds-text-dark)'};`;lb.textContent=isDone?'✓ '+p.name:p.name;btn.appendChild(lb);
    btn.onclick=()=>openSubmit(p);sp.appendChild(btn);
  });
  // guess button
  const gb=document.getElementById('guess-btn');
  gb.disabled=done===0;
  gb.textContent=done>=total?'Everyone\'s in — start guessing →':'Start guessing';
  const mn=document.getElementById('missing-note');const miss=total-done;
  mn.style.display=(done>0&&miss>0)?'block':'none';
  mn.textContent=`${miss} player${miss>1?'s':''} still to submit`;
}
function copyRoomCode(){navigator.clipboard.writeText(roomCode).then(()=>showToast('Room code copied')).catch(()=>showToast('Code: '+roomCode));}
function changeQuestion(){showScreen('screen-pick-q');}
function startEditQ(){document.getElementById('q-display').style.display='none';document.getElementById('q-edit').style.display='block';document.getElementById('q-draft').value=question;document.getElementById('q-draft').focus();}
function cancelEditQ(){document.getElementById('q-display').style.display='block';document.getElementById('q-edit').style.display='none';}
async function saveQ(){const q=document.getElementById('q-draft').value.trim();if(!q)return;question=q;document.getElementById('q-display').textContent=q;cancelEditQ();await saveQuestionRemote(q);}
async function manualRefresh(){
  if(!firebaseUrl||!roomCode)return;
  const icon=document.getElementById('refresh-icon');
  if(icon){icon.style.display='inline-block';icon.style.animation='spin 0.6s linear';setTimeout(()=>{icon.style.animation='';},700);}
  try{const data=await fbGet(`games/${roomCode}`);if(data){if(data.question)question=data.question;if(data.submissions)submissions=data.submissions;if(data.activePlayers)activePlayers=data.activePlayers;renderWaiting();showToast('Refreshed');}}
  catch(e){showToast('Could not refresh — check connection');}
}

// ═══════════════════════════════════════════════════════════
//  SUBMIT
// ═══════════════════════════════════════════════════════════
function openSubmit(player){
  selectedPlayer=player;const ex=submissions[player.id];
  document.getElementById('submit-player-name').textContent=player.name;
  setAv(document.getElementById('submit-player-av'),player,32);
  document.getElementById('submit-q').textContent=question;
  document.getElementById('answer-input').value=ex?.answer||'';
  if(ex)showDone(ex.answer,player);
  else{document.getElementById('submit-form').style.display='block';document.getElementById('submit-done').style.display='none';setTimeout(()=>document.getElementById('answer-input').focus(),100);}
  showScreen('screen-submit');
}
function showDone(ans,player){
  document.getElementById('submit-form').style.display='none';document.getElementById('submit-done').style.display='block';
  setAv(document.getElementById('submit-done-av'),player||selectedPlayer,56);
  document.getElementById('done-answer-text').textContent=ans;
}
async function submitAnswer(){
  const ans=document.getElementById('answer-input').value.trim();
  if(!ans){showToast('Type your answer first');return;}
  showLoading('Saving your answer…');
  try{
    const emoji=localEmojiArt(ans);
    let cover=await generateImage(ans,question);
    if(!cover)cover=await fetchCover(ans);
    const sub={answer:ans,emojiArt:emoji,cover};
    submissions[selectedPlayer.id]=sub;
    await saveSubmission(selectedPlayer.id,sub);
    showDone(ans,selectedPlayer);
  }catch(e){showToast('Submission failed — try again');}
  finally{hideLoading();}
}
function editAnswer(){document.getElementById('submit-form').style.display='block';document.getElementById('submit-done').style.display='none';setTimeout(()=>document.getElementById('answer-input').focus(),50);}
function backToWaiting(){renderWaiting();showScreen('screen-waiting');}

// ═══════════════════════════════════════════════════════════
//  GUESSING
// ═══════════════════════════════════════════════════════════
function handleGuessClick(){
  const miss=activePlayers.length-Object.keys(submissions).length;
  if(miss>0)showConfirm(`${miss} player${miss>1?" haven't":" hasn't"} submitted yet. Start anyway?`,startGuessing);
  else startGuessing();
}
function startGuessing(){
  stopAll();
  cards=shuffle(activePlayers.filter(p=>submissions[p.id]).map(p=>({...submissions[p.id],name:p.name,playerId:p.id,person:p})));
  document.getElementById('guessing-q').textContent=`"${question}"`;
  renderCards(false);showScreen('screen-guessing');
}
function renderCards(allFlipped){
  const grid=document.getElementById('cards-grid');grid.innerHTML='';
  cards.forEach((card,i)=>{
    const wrap=document.createElement('div');wrap.className='flip-wrap'+(allFlipped?' flipped':'');
    wrap.innerHTML=`<div class="flip-inner">
      <div class="flip-face flip-front">
        <div class="card-text-half">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--ds-text-regular);">Card ${i+1}</span>
          <div style="font-size:clamp(13px,1.6vw,15px);font-weight:700;color:var(--ds-text-dark);line-height:1.5;flex:1;display:flex;align-items:center;padding:var(--ds-space-03) 0;">
            <span style="border-left:3px solid var(--ds-color-company-red);padding-left:var(--ds-space-03);">${esc(card.answer)}</span>
          </div>
          <span style="font-size:11px;color:var(--ds-text-regular);">Tap to reveal →</span>
        </div>
        <div class="card-img-half">${mediaHTML(card.cover,card.emojiArt,i)}</div>
      </div>
      <div class="flip-face flip-back">
        <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--ds-text-regular);">This was…</span>
        <div id="bav-${i}"></div>
        <span style="font-size:clamp(18px,4vw,24px);font-weight:700;color:var(--ds-text-black);text-align:center;padding:0 var(--ds-space-04);">${esc(card.name)}</span>
      </div>
    </div>`;
    wrap.onclick=()=>wrap.classList.toggle('flipped');
    grid.appendChild(wrap);
    const bav=document.getElementById(`bav-${i}`);
    if(bav)bav.appendChild(mkAvatar(card.person,56,'border:2px solid var(--ds-color-company-red);'));
  });
}
function revealAll(){document.querySelectorAll('.flip-wrap').forEach((w,i)=>setTimeout(()=>w.classList.add('flipped'),i*150));setTimeout(confetti,400);}

// ═══════════════════════════════════════════════════════════
//  RESULTS
// ═══════════════════════════════════════════════════════════
function goToResults(){
  confetti();
  document.getElementById('results-q').textContent=`"${question}"`;
  const list=document.getElementById('results-list');list.innerHTML='';
  cards.forEach((card,i)=>{
    const row=document.createElement('div');
    row.style.cssText=`display:flex;align-items:center;border:1px solid var(--ds-stroke);border-left:3px solid var(--ds-color-company-red);margin-bottom:var(--ds-space-03);overflow:hidden;background:var(--ds-color-white);animation:slideUp 0.3s ${i*0.06}s ease both;`;
    const med=document.createElement('div');med.style.cssText='width:72px;height:72px;flex-shrink:0;';med.innerHTML=mediaHTML(card.cover,card.emojiArt,i);row.appendChild(med);
    const body=document.createElement('div');body.style.cssText='flex:1;padding:var(--ds-space-03) var(--ds-space-04);min-width:0;';
    const nr=document.createElement('div');nr.style.cssText='display:flex;align-items:center;gap:var(--ds-space-03);margin-bottom:var(--ds-space-02);';
    nr.appendChild(mkAvatar(card.person,28));
    const nm=document.createElement('span');nm.style.cssText='font-weight:700;font-size:15px;color:var(--ds-text-black);';nm.textContent=card.name;nr.appendChild(nm);body.appendChild(nr);
    const at=document.createElement('div');at.style.cssText='font-size:14px;color:var(--ds-text-dark);line-height:1.4;';at.textContent=`"${card.answer}"`;body.appendChild(at);row.appendChild(body);list.appendChild(row);
  });
  showScreen('screen-results');
}
function playAgain(){stopAll();submissions={};cards=[];roomCode=null;question='';selectedPlayer=null;selIds=roster.map(m=>m.id);showScreen('screen-create');}

// ═══════════════════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════════════════
const PREFILLED_FIREBASE='https://guess-that-thing-default-rtdb.europe-west1.firebasedatabase.app';
loadRoster();
// Always ensure the pre-filled Firebase URL is set — overwrite only if empty or still default
const existingFb = getFirebaseUrl();
if(!existingFb || existingFb === PREFILLED_FIREBASE || !existingFb.startsWith('https://')) {
  localStorage.setItem('gtt-firebase', PREFILLED_FIREBASE);
}
firebaseUrl = getFirebaseUrl();
document.getElementById('fb-url-input').value = firebaseUrl;
showScreen('screen-home');
</script>
