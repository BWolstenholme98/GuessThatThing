            <span><span style="color:rgba(255,209,102,.5);font-size:1.4rem;line-height:0;vertical-align:-.25em;margin-right:3px;">"</span>${esc(card.answer)}<span style="color:rgba(255,209,102,.5);font-size:1.4rem;line-height:0;vertical-align:-.25em;margin-left:3px;">"</span></span>
          </div>
          <div style="color:var(--muted);font-size:.68rem;">👆 tap to reveal</div>
        </div>
