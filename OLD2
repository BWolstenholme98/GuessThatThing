// ═══════════════════════════════════════════════════════════
//  COVER ART (free public API — no key needed)
// ═══════════════════════════════════════════════════════════
async function fetchCover(ans){
  const lo=ans.toLowerCase();

  // Only attempt cover art if the answer strongly suggests a specific named work.
  // We require an explicit keyword AND the answer to look like a title (3+ chars after stripping qualifiers).
  const hasAlbumKw  = /\b(album|record|lp|ep|mixtape|vinyl|discography)\b/.test(lo);
  const hasMusicKw  = /\b(by |from |artist |band |singer |rapper )/.test(lo);
  const hasMovieKw  = /\b(film|movie|series|show|documentary|directed by)\b/.test(lo);
  const hasBookKw   = /\b(book|novel|memoir|biography|by )/.test(lo);
  const hasPodKw    = /\b(podcast)\b/.test(lo);

  // Strip filler words to get the likely title
  const term = ans
    .replace(/\b(the|a|an|by|from|with|my fav(ou?rite)?|probably|definitely|honestly|something like|i('d| would| think)( go with| pick| say| choose)?)\b/gi,'')
    .replace(/\b(album|record|lp|ep|mixtape|vinyl|film|movie|series|show|documentary|book|novel|memoir|biography|podcast)\b/gi,'')
    .trim().slice(0, 80);

  // Bail out early if the answer is too vague/short to be a real title
  // (e.g. "Italian food", "Spanish", "cooking")
  if(term.length < 4) return {type:'svg'};

  // Also bail if the answer is likely a genre, cuisine, language, or activity
  // rather than a named title — these never yield good cover matches
  const isVague = /^(jazz|rock|pop|hip.?hop|classical|country|r&b|soul|electronic|techno|house|metal|punk|indie|folk|blues|reggae|latin|afrobeat|gospel|opera)$/i.test(term.trim());
  const isCuisine = /^(italian|french|japanese|chinese|indian|mexican|thai|spanish|greek|korean|vietnamese|lebanese|turkish|moroccan|peruvian|american|british|german|brazilian|sushi|pasta|pizza|curry|tapas|dim.?sum|ramen|tacos|bbq|steak|seafood)$/i.test(term.trim());
  const isActivity = /^(cooking|reading|writing|running|cycling|swimming|hiking|gaming|drawing|painting|photography|travel|yoga|meditation|dancing|singing|acting|coding|investing)$/i.test(term.trim());
  if(isVague || isCuisine || isActivity) return {type:'svg'};

  // Only attempt a lookup if we have a real keyword signal
  const doMusic = hasAlbumKw || hasMusicKw;
  const doMovie = hasMovieKw;
  const doBook  = hasBookKw;
  const doPod   = hasPodKw;

  if(!doMusic && !doMovie && !doBook && !doPod) return {type:'svg'};

  try{
    if(doMusic || doPod){
      const entity = doPod ? 'podcast' : 'album';
      const media  = doPod ? 'podcast' : 'music';
      const r = await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(term)}&entity=${entity}&limit=3&media=${media}`);
      const d = await r.json();
      if(d.results?.length){
        // Check the top result name roughly matches our term (avoid wild mismatches)
        const top = d.results[0];
        const resultName = (top.collectionName||top.trackName||'').toLowerCase();
        const termWords = term.toLowerCase().split(/\s+/).filter(w=>w.length>2);
        const matchCount = termWords.filter(w=>resultName.includes(w)).length;
        if(matchCount >= Math.max(1, Math.floor(termWords.length * 0.5))){
          const art = (top.artworkUrl100||'').replace('100x100bb','400x400bb');
          if(art) return {type:'image', url:art};
        }
      }
    }
    if(doMovie){
      const r = await fetch(`https://itunes.apple.com/search?term=${encodeURIComponent(term)}&entity=movie&limit=3&media=movie`);
      const d = await r.json();
      if(d.results?.length){
        const top = d.results[0];
        const resultName = (top.trackName||'').toLowerCase();
        const termWords = term.toLowerCase().split(/\s+/).filter(w=>w.length>2);
        const matchCount = termWords.filter(w=>resultName.includes(w)).length;
        if(matchCount >= Math.max(1, Math.floor(termWords.length * 0.5))){
          const art = (top.artworkUrl100||'').replace('100x100bb','400x400bb');
          if(art) return {type:'image', url:art};
        }
      }
    }
    if(doBook){
      const r = await fetch(`https://openlibrary.org/search.json?q=${encodeURIComponent(term)}&limit=3&fields=title,cover_i`);
      const d = await r.json();
      if(d.docs?.length){
        const top = d.docs[0];
        const resultName = (top.title||'').toLowerCase();
        const termWords = term.toLowerCase().split(/\s+/).filter(w=>w.length>2);
        const matchCount = termWords.filter(w=>resultName.includes(w)).length;
        if(matchCount >= Math.max(1, Math.floor(termWords.length * 0.5)) && top.cover_i){
          return {type:'image', url:`https://covers.openlibrary.org/b/id/${top.cover_i}-L.jpg`};
        }
      }
    }
  }catch{}
  return{type:'svg'};
}

