//  FIREBASE
// ═══════════════════════════════════════════════════════════
function fbUrl(path){return `${firebaseUrl}/${path}.json`;}
async function fbGet(path){const r=await fetch(fbUrl(path));if(!r.ok)throw new Error('FB '+r.status);return r.json();}
async function fbPut(path,data){const r=await fetch(fbUrl(path),{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(!r.ok)throw new Error('FB PUT '+r.status);return r.json();}
async function fbPatch(path,data){const r=await fetch(fbUrl(path),{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(!r.ok)throw new Error('FB PATCH '+r.status);return r.json();}

function startSSE(code){
  stopAll();
  try{
    sseSource=new EventSource(`${firebaseUrl}/games/${code}.json?stream=true`);
    sseSource.addEventListener('put',e=>{try{const d=JSON.parse(e.data);if(d&&d.data)onRemoteUpdate(d.data);}catch{}});
    sseSource.addEventListener('patch',e=>{try{const d=JSON.parse(e.data);if(d&&d.data)onRemoteUpdate(d.data);}catch{}});
    sseSource.onerror=()=>{stopSSE();startPolling(code);};
  }catch{startPolling(code);}
}
function stopSSE(){if(sseSource){sseSource.close();sseSource=null;}}
function startPolling(code){
  stopPolling();
  pollTimer=setInterval(async()=>{
    try{const data=await fbGet(`games/${code}`);if(data)onRemoteUpdate(data);}catch{}
  },3000);
}
function stopPolling(){if(pollTimer){clearInterval(pollTimer);pollTimer=null;}}
function stopAll(){stopSSE();stopPolling();}

function onRemoteUpdate(data){
  if(!data)return;
  const changed=JSON.stringify(data.submissions)!==JSON.stringify(submissions);
  if(data.question&&data.question!==question){
    question=data.question;
    const qd=document.getElementById('q-display');
    if(qd)qd.textContent=question;
  }
  if(data.submissions)submissions=data.submissions;
  if(data.activePlayers)activePlayers=data.activePlayers;
  if(changed&&document.getElementById('screen-waiting').classList.contains('active'))renderWaiting();
}

