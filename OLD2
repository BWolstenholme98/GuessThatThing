async function submitAnswer(){
  const ans=document.getElementById('answer-input').value.trim();
  if(!ans){showToast('Type your answer first!');return;}
  showLoading('Crafting your mystery card…');
  try{
    const[emoji,cover]=await Promise.all([
      Promise.resolve(localEmojiArt(ans)),
      fetchCover(ans),
    ]);
    const sub={answer:ans,emojiArt:emoji,cover};
    submissions[selectedPlayer.id]=sub;
    await saveSubmission(selectedPlayer.id,sub);
    showDone(ans,selectedPlayer);
  }catch(e){showToast('Submission failed — try again!');}
  finally{hideLoading();}
}
