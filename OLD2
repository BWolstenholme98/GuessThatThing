function renderQuestionPicker(){
  document.getElementById('custom-q-input').value='';
  shuffleQuestionList();
}

function shuffleQuestionList(){
  const shuffled=shuffle([...Array(QUESTIONS.length).keys()]);
  displayedQIds=shuffled.slice(0,8); // show 8 at a time
  const list=document.getElementById('q-option-list');list.innerHTML='';
  displayedQIds.forEach(idx=>{
    const btn=document.createElement('button');
    btn.className='q-option';
    btn.textContent=QUESTIONS[idx];
    btn.onclick=()=>useQuestion(QUESTIONS[idx]);
    list.appendChild(btn);
  });
}

function useCustomQuestion(){
  const q=document.getElementById('custom-q-input').value.trim();
  if(!q){showToast('Type a question first');return;}
  useQuestion(q);
}

async function useQuestion(q){
  question=q;
  roomCode=genCode();
  submissions={};
  showLoading('Setting up game…');
  try{
    const playersForDb=activePlayers.map(({id,name})=>({id,name}));
    await fbPut(`games/${roomCode}`,{question,activePlayers:playersForDb,submissions:{},createdAt:Date.now()});
    startSSE(roomCode);
    renderWaiting();
    showScreen('screen-waiting');
  }catch(e){showToast('Error connecting to Firebase: '+e.message);}
  finally{hideLoading();}
}

// ═══════════════════════════════════════════════════════════
//  JOIN
// ═══════════════════════════════════════════════════════════
async function joinRoom(){
  const code=document.getElementById('join-code').value.trim().toUpperCase();
  if(!code){showToast('Enter a room code');return;}
  if(!firebaseUrl){showToast('Connect Firebase first');showScreen('screen-firebase');return;}
  showLoading('Joining game…');
  try{
    const data=await fbGet(`games/${code}`);
    if(!data){showToast('Room not found — check the code');hideLoading();return;}
    roomCode=code;question=data.question;
    activePlayers=(data.activePlayers||[]).map(rp=>{
      const local=roster.find(m=>m.id===rp.id||m.name===rp.name);
      return local?{...rp,photo:local.photo}:{...rp};
    });
    submissions=data.submissions||{};
    startSSE(roomCode);
    renderWaiting();
    showScreen('screen-waiting');
  }catch(e){showToast('Could not join: '+e.message);}
  finally{hideLoading();}
}

// ═══════════════════════════════════════════════════════════
//  WAITING / LOBBY
// ═══════════════════════════════════════════════════════════
function renderWaiting(){
  const total=activePlayers.length,done=Object.keys(submissions).length;
  document.getElementById('room-code-display').textContent=roomCode;

  // topbar avatars
  const tr=document.getElementById('waiting-top-right');tr.innerHTML=`<span style="font-size:.8rem;color:var(--muted);">${done}/${total} in</span>`;
  activePlayers.slice(0,5).forEach((p,i)=>{
    const av=mkAvatar(p,30,`margin-left:${i>0?-6:0}px;border:2px solid var(--navy);opacity:${submissions[p.id]?1:.4};`);
    tr.appendChild(av);
  });

  // question
  document.getElementById('q-display').textContent=question;

  // progress
  document.getElementById('sub-chip').textContent=`${done} / ${total}`;
  document.getElementById('sub-bar').style.width=`${total?(done/total)*100:0}%`;

  // sub name chips
  const sn=document.getElementById('sub-names');sn.innerHTML='';
  activePlayers.forEach(p=>{
    const isDone=!!submissions[p.id];
    const chip=document.createElement('div');chip.className='sub-chip '+(isDone?'done':'pending');
    const av=mkAvatar(p,28,`opacity:${isDone?1:.5};`);chip.appendChild(av);
    const lb=document.createElement('span');lb.style.cssText='font-size:.8rem;font-weight:500;color:'+(isDone?'var(--teal)':'var(--muted)')+';';
    lb.textContent=(isDone?'✓ ':'')+p.name;chip.appendChild(lb);sn.appendChild(chip);
  });

  // submit picker
  const sp=document.getElementById('submit-picker');sp.innerHTML='';
  activePlayers.forEach(p=>{
    const isDone=!!submissions[p.id];
    const btn=document.createElement('button');
    btn.style.cssText=`display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 14px;background:${isDone?'rgba(78,205,196,.1)':'var(--light)'};border:1px solid ${isDone?'rgba(78,205,196,.2)':'rgba(255,255,255,.1)'};border-radius:14px;cursor:pointer;font-family:'Inter',sans-serif;`;
    btn.appendChild(mkAvatar(p,44));
    const lb=document.createElement('span');lb.style.cssText='font-size:.8rem;font-weight:500;color:'+(isDone?'var(--teal)':'var(--off)')+';';
    lb.textContent=(isDone?'✓ ':'')+p.name;btn.appendChild(lb);
    btn.onclick=()=>openSubmit(p);
    sp.appendChild(btn);
  });

  // guess button
  const gb=document.getElementById('guess-btn');
  gb.disabled=done===0;
  gb.textContent=done>=total?"Everyone's in — Let's Guess! 🕵️":"Start Guessing →";
  const mn=document.getElementById('missing-note');const miss=total-done;
  mn.style.display=(done>0&&miss>0)?'block':'none';
  mn.textContent=`${miss} player${miss>1?'s':''} still to submit`;
}

async function manualRefresh(){
  if(!firebaseUrl||!roomCode)return;
  const btn=document.getElementById('refresh-btn');
  const icon=document.getElementById('refresh-icon');
  if(icon){icon.style.animation='spin .6s linear';setTimeout(()=>icon.style.animation='',700);}
  try{
    const data=await fbGet(`games/${roomCode}`);
    if(data){
      if(data.question)question=data.question;
      if(data.submissions)submissions=data.submissions;
      if(data.activePlayers)activePlayers=data.activePlayers;
      renderWaiting();
      showToast('Refreshed ✓');
    }
  }catch(e){showToast('Could not refresh — check your connection');}
}

function copyRoomCode(){
  navigator.clipboard.writeText(roomCode).then(()=>showToast('Copied! '+roomCode)).catch(()=>showToast('Code: '+roomCode));
}

