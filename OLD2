      </div>
      <div class="flip-face flip-back">
        <div style="font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;font-weight:700;">This was…</div>
        <div id="bav-${i}"></div>
        <div style="font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(1.4rem,4vw,2rem);color:var(--gold);text-align:center;padding:0 16px;line-height:1.1;">${esc(card.name)}</div>
      </div>
    </div>`;
    wrap.onclick=()=>wrap.classList.toggle('flipped');
    grid.appendChild(wrap);
    const bav=document.getElementById(`bav-${i}`);
    if(bav)bav.appendChild(mkAvatar(card.person,64,'border:3px solid rgba(255,209,102,.5);box-shadow:0 0 20px rgba(255,209,102,.2);'));
  });
}
function revealAll(){document.querySelectorAll('.flip-wrap').forEach((w,i)=>setTimeout(()=>w.classList.add('flipped'),i*150));setTimeout(confetti,400);}

// ═══════════════════════════════════════════════════════════
//  RESULTS
// ═══════════════════════════════════════════════════════════
function goToResults(){
  confetti();
  document.getElementById('results-q').textContent=`"${question}"`;
  const list=document.getElementById('results-list');list.innerHTML='';
  cards.forEach((card,i)=>{
    const row=document.createElement('div');row.className='card';
    row.style.cssText=`display:flex;align-items:center;margin-bottom:12px;overflow:hidden;padding:0;animation:slideUp .4s ${i*.07}s ease both;`;
    const med=document.createElement('div');med.style.cssText='width:80px;height:80px;flex-shrink:0;';
    med.innerHTML=mediaHTML(card.cover,card.emojiArt,i);row.appendChild(med);
    const body=document.createElement('div');body.style.cssText='flex:1;padding:14px 16px;min-width:0;';
    const nr=document.createElement('div');nr.style.cssText='display:flex;align-items:center;gap:10px;margin-bottom:4px;';
    nr.appendChild(mkAvatar(card.person,32));
    const nm=document.createElement('span');nm.style.cssText="font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;color:var(--gold);";nm.textContent=card.name;
    nr.appendChild(nm);body.appendChild(nr);
    const at=document.createElement('div');at.style.cssText='font-size:.88rem;color:var(--off);line-height:1.5;';at.textContent=`"${card.answer}"`;
    body.appendChild(at);row.appendChild(body);list.appendChild(row);
  });
  showScreen('screen-results');
}
function playAgain(){
  stopAll();submissions={};cards=[];roomCode=null;question='';selectedPlayer=null;
  selIds=roster.map(m=>m.id);
  showScreen('screen-create');
}

// ═══════════════════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════════════════
const PREFILLED_FIREBASE='https://guess-that-thing-default-rtdb.europe-west1.firebasedatabase.app';
loadRoster();
// Pre-fill Firebase URL for everyone on first open
if(!getFirebaseUrl()){
  localStorage.setItem('gtt-firebase',PREFILLED_FIREBASE);
}
firebaseUrl=getFirebaseUrl();
// Pre-fill the settings input field too
document.getElementById('fb-url-input').value=firebaseUrl;
// Skip setup screen — go straight to home
showScreen('screen-home');
</script>
