function mkAvatar(person,size,xtra=''){
  const[g1,g2]=GRAD[(person?.name?.charCodeAt(0)||0)%GRAD.length];
  if(person?.photo){
    const img=document.createElement('img');
    img.src=person.photo;img.className='avatar';
    img.style.cssText=`width:${size}px;height:${size}px;${xtra}`;
    img.onerror=()=>img.replaceWith(mkInit(person,size,xtra));
    return img;
  }
  return mkInit(person,size,xtra);
}
function mkInit(person,size,xtra=''){
  const d=document.createElement('div');d.className='avatar-init';
  d.style.cssText=`width:${size}px;height:${size}px;background:linear-gradient(135deg,${GRAD[(person?.name?.charCodeAt(0)||0)%GRAD.length].join(',')});font-size:${Math.round(size*.38)}px;${xtra}`;
  d.textContent=(person?.name||'?')[0].toUpperCase();return d;
}
function setAv(el,person,size,xtra=''){el.innerHTML='';el.appendChild(mkAvatar(person,size,xtra));}

// ═══════════════════════════════════════════════════════════
//  SVG / MEDIA
// ═══════════════════════════════════════════════════════════
function svgArt(emoji,idx){
  const[g1,g2]=GRAD[idx%GRAD.length];
  const gl=[...(emoji||'🎭✨')].slice(0,4);
  const pos=[{x:50,y:38},{x:50,y:72},{x:26,y:55},{x:74,y:55}];
  const fs=gl.length===1?38:gl.length===2?28:22;
  const dots=[12,25,38,62,75,88].flatMap(x=>[15,50,85].map(y=>`<circle cx="${x}" cy="${y}" r=".8" fill="rgba(255,255,255,.18)"/>`)).join('');
  const txts=gl.map((g,i)=>`<text x="${pos[i]?.x??50}" y="${pos[i]?.y??50}" text-anchor="middle" dominant-baseline="middle" font-size="${fs}" style="user-select:none">${g}</text>`).join('');
  return `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;"><defs><linearGradient id="sg${idx}" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="${g1}" stop-opacity=".9"/><stop offset="100%" stop-color="${g2}" stop-opacity=".9"/></linearGradient></defs><rect width="100" height="100" fill="url(#sg${idx})"/>${dots}${txts}</svg>`;
}

// Generate emoji art locally — no API needed
function localEmojiArt(answer){
  const lo=answer.toLowerCase();
  const maps=[
    [/\b(music|album|band|song|guitar|piano|drum|sing|concert|vinyl|spotify)\b/,'🎵🎸🎤🎶'],
    [/\b(film|movie|cinema|actor|direct|oscar|hollywood|netflix|watch|screen)\b/,'🎬🎥🍿🎞️'],
    [/\b(book|read|novel|author|write|story|librar|fiction|chapter)\b/,'📚📖✍️🖊️'],
    [/\b(food|eat|cook|chef|restaurant|meal|recipe|taste|kitchen|dish)\b/,'🍽️👨‍🍳🥘🍜'],
    [/\b(travel|trip|country|city|flight|beach|mountain|hotel|explore|world)\b/,'✈️🌍🗺️🧳'],
    [/\b(sport|run|gym|football|tennis|swim|cycling|train|fitness|match)\b/,'🏃‍♂️⚽🎾🏋️'],
    [/\b(art|paint|draw|creat|design|sculpt|museum|gallery|colour|canvas)\b/,'🎨🖌️🖼️✨'],
    [/\b(tech|code|program|software|app|data|compute|ai|digital|hack)\b/,'💻🤖⌨️🔧'],
    [/\b(nature|garden|plant|hike|outdoor|forest|animal|dog|cat|bird)\b/,'🌿🌳🐾🦋'],
    [/\b(space|star|planet|astronaut|rocket|cosmos|universe|galaxy|nasa)\b/,'🚀🌟🪐🌌'],
    [/\b(game|play|chess|poker|board|video|rpg|puzzle|strategy|win)\b/,'🎮♟️🎲🏆'],
    [/\b(dream|imagin|fantasy|magic|unicorn|adventure|explore|quest|hero)\b/,'✨🌈🦄💫'],
    [/\b(money|invest|finance|bank|stock|rich|wealth|business|startup)\b/,'💰📈💼🏦'],
    [/\b(doctor|health|medic|hospital|nurse|cure|treat|scienc|research)\b/,'🏥🔬💊🩺'],
    [/\b(teach|school|educat|university|learn|student|lecture|class|profess)\b/,'🎓📝🏫📚'],
    [/\b(laugh|comedy|joke|funny|humor|stand.up|entertain|perform|clown)\b/,'😂🎭🤣🎪'],
    [/\b(coffee|cafe|espresso|latte|barista|brew|morning|cup|bean)\b/,'☕🫘🧋🍵'],
    [/\b(wine|beer|drink|cocktail|bar|whisky|gin|champagne|sommelier)\b/,'🍷🍺🍸🥂'],
    [/\b(fashion|cloth|style|design|dress|shoe|luxury|brand|outfit|wear)\b/,'👗👠👜✨'],
    [/\b(family|parent|child|kid|home|house|domestic|wedding|partner|love)\b/,'🏠❤️👨‍👩‍👧🌸'],
  ];
  for(const[rx,art]of maps)if(rx.test(lo))return art;
  // Fallback — generate from first letter
  const starters={'a':'🌟✨💫🎯','b':'🎯💡🔮🌈','c':'☀️🌟💎✨','d':'🎭🌙⭐💫','e':'🌿✨🎨🌟','f':'🔥⚡💥🌟','g':'💚🌿🌟✨','h':'🏔️🌅✨💫','i':'💡🌟⭐✨','j':'🎸🎵🎶✨','k':'🔑💫🌟✨','l':'❤️💫🌟✨','m':'🌙✨💫⭐','n':'🌙⭐💫✨','o':'🌊🌀✨💫','p':'🎨✨💫🌟','q':'🔮💫✨⭐','r':'🌹❤️✨💫','s':'⭐✨🌟💫','t':'🌿🎯✨💫','u':'☂️💫✨🌟','v':'💫✨🌟⭐','w':'🌊💫✨🌟','x':'✨💫⭐🌟','y':'💛✨💫🌟','z':'⚡✨💫🌟'};
  return starters[lo[0]]||'🎭✨🌟💡';
}

function mediaHTML(cover,emoji,idx){
  if(cover?.type==='image'&&cover.url)return`<img src="${cover.url}" alt="" onerror="this.outerHTML='${svgArt(emoji,idx).replace(/'/g,"&#39;")}'" style="width:100%;height:100%;object-fit:cover;display:block;">`;
  return svgArt(emoji,idx);
}

