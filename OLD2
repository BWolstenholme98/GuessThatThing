<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guess That Thing 🎯</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--navy:#0D1B2A;--mid:#162236;--light:#1E3050;--card:#1A2D45;--coral:#FF4D6D;--gold:#FFD166;--teal:#4ECDC4;--off:#F0F4FF;--muted:#8899BB;}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Inter',sans-serif;background:var(--navy);color:#fff;min-height:100vh;overflow-x:hidden;}
.screen{display:none;min-height:100vh;flex-direction:column;}
.screen.active{display:flex;}
.centre{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;text-align:center;}
.wrap{max-width:880px;margin:0 auto;padding:24px 20px;width:100%;}
.wrap-sm{max-width:560px;margin:0 auto;padding:24px 20px;width:100%;}
.wrap-md{max-width:680px;margin:0 auto;padding:24px 20px;width:100%;}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;border-bottom:1px solid rgba(255,255,255,.06);flex-shrink:0;}
.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.05rem;color:var(--gold);letter-spacing:-.02em;}
.logo span{color:var(--coral);}
h1{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(2rem,5vw,3rem);line-height:1.1;letter-spacing:-.03em;}
h2{font-family:'Syne',sans-serif;font-weight:700;font-size:clamp(1.2rem,3vw,1.8rem);letter-spacing:-.02em;}
h3{font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;}
.eyebrow{font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--coral);margin-bottom:10px;}
.muted{color:var(--muted);font-size:.9rem;line-height:1.6;}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:none;border-radius:10px;cursor:pointer;font-family:'Inter',sans-serif;font-weight:600;font-size:.9rem;transition:all .15s;padding:13px 26px;}
.btn:hover:not(:disabled){filter:brightness(1.08);transform:translateY(-1px);}
.btn:active:not(:disabled){transform:translateY(0)!important;filter:brightness(.96);}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none!important;}
.btn-primary{background:var(--coral);color:#fff;}
.btn-gold{background:var(--gold);color:var(--navy);}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid rgba(255,255,255,.14);}
.btn-outline{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.3);}
.btn-danger{background:rgba(255,77,109,.12);color:var(--coral);border:1px solid rgba(255,77,109,.3);}
.btn-lg{padding:16px 32px;font-size:1rem;border-radius:12px;}
.btn-sm{padding:8px 14px;font-size:.82rem;}
.btn-block{width:100%;}
input[type=text],textarea{width:100%;padding:13px 15px;background:var(--card);border:1px solid rgba(255,255,255,.1);border-radius:10px;color:#fff;font-family:'Inter',sans-serif;font-size:.95rem;outline:none;transition:border-color .15s;}
input:focus,textarea:focus{border-color:var(--coral)!important;}
input::placeholder,textarea::placeholder{color:var(--muted);}
textarea{resize:vertical;}
.card{background:var(--card);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:24px;}
.chip{display:inline-block;padding:4px 11px;background:rgba(255,77,109,.15);color:var(--coral);border:1px solid rgba(255,77,109,.25);border-radius:20px;font-size:.76rem;font-weight:600;}
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--light);border:1px solid rgba(255,255,255,.12);color:#fff;padding:11px 22px;border-radius:30px;font-size:.88rem;font-weight:500;z-index:9999;white-space:nowrap;box-shadow:0 8px 32px rgba(0,0,0,.4);transition:transform .35s cubic-bezier(.34,1.56,.64,1);}
#toast.show{transform:translateX(-50%) translateY(0);}
#loading{display:none;position:fixed;inset:0;background:rgba(13,27,42,.93);z-index:1000;align-items:center;justify-content:center;flex-direction:column;gap:16px;}
#loading.show{display:flex;}
.spinner{width:48px;height:48px;border:4px solid rgba(255,255,255,.1);border-top-color:var(--coral);border-radius:50%;animation:spin .9s linear infinite;}
#loading-text{color:var(--muted);font-weight:600;font-size:.95rem;}
.overlay{display:none;position:fixed;inset:0;background:rgba(13,27,42,.88);z-index:2000;align-items:center;justify-content:center;padding:20px;}
.overlay.show{display:flex;}
.dialog-box{background:var(--card);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:32px;max-width:440px;width:100%;}
.avatar{border-radius:50%;object-fit:cover;flex-shrink:0;display:block;}
.avatar-init{border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;color:#fff;}
.flip-wrap{perspective:1200px;cursor:pointer;flex:1 1 300px;min-width:280px;max-width:440px;height:210px;}
.flip-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .65s cubic-bezier(.4,.2,.2,1);}
.flip-wrap.flipped .flip-inner{transform:rotateY(180deg);}
.flip-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:16px;overflow:hidden;}
.flip-front{background:var(--card);border:1px solid rgba(255,255,255,.1);display:flex;}
.flip-back{background:linear-gradient(135deg,var(--mid),var(--light));border:1px solid rgba(255,209,102,.3);transform:rotateY(180deg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;}
.card-text-half{flex:1;padding:18px 20px;display:flex;flex-direction:column;justify-content:space-between;min-width:0;}
.card-img-half{width:140px;flex-shrink:0;}
.card-img-half img,.card-img-half svg{width:100%;height:100%;object-fit:cover;display:block;}
.progress-track{height:6px;background:var(--light);border-radius:3px;overflow:hidden;}
.progress-fill{height:100%;background:var(--coral);border-radius:3px;transition:width .5s ease;}
.room-code-box{font-family:'Syne',sans-serif;font-weight:800;font-size:2.8rem;letter-spacing:.2em;color:var(--gold);text-align:center;padding:20px 24px;background:rgba(255,209,102,.06);border:2px dashed rgba(255,209,102,.25);border-radius:16px;cursor:pointer;transition:background .15s;user-select:all;}
.room-code-box:hover{background:rgba(255,209,102,.1);}
.player-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;}
.player-tile{display:flex;flex-direction:column;align-items:center;gap:10px;padding:16px 12px;background:var(--card);border:1px solid rgba(255,255,255,.08);border-radius:14px;cursor:pointer;position:relative;transition:all .15s;font-family:'Inter',sans-serif;font-weight:600;font-size:.88rem;color:var(--off);border:none;}
.player-tile.sel{background:rgba(255,77,109,.15);outline:1.5px solid var(--coral);}
.player-tile .tick{position:absolute;top:8px;right:8px;width:18px;height:18px;background:var(--coral);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;font-weight:700;}
.sub-chip{display:flex;align-items:center;gap:8px;padding:6px 12px 6px 6px;border-radius:30px;}
.sub-chip.done{background:rgba(78,205,196,.12);border:1px solid rgba(78,205,196,.25);}
.sub-chip.pending{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);}
/* Question picker */
.q-option{background:var(--card);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:14px 18px;cursor:pointer;font-size:.92rem;line-height:1.45;color:var(--off);transition:all .15s;text-align:left;font-family:'Inter',sans-serif;width:100%;}
.q-option:hover{border-color:var(--coral);background:rgba(255,77,109,.08);color:#fff;}
@keyframes spin{to{transform:rotate(360deg);}}
@keyframes confettiFall{0%{transform:translateY(-20px) rotate(0);opacity:1;}100%{transform:translateY(110vh) rotate(720deg);opacity:0;}}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
@keyframes slideUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
.confetti-piece{position:fixed;pointer-events:none;z-index:9000;animation:confettiFall linear forwards;}
#screen-home{background:radial-gradient(ellipse 80% 60% at 50% -10%,rgba(255,77,109,.12) 0%,transparent 70%);}
#screen-waiting{background:radial-gradient(ellipse 60% 50% at 50% 0%,rgba(255,209,102,.07) 0%,transparent 60%);}
#screen-submit{background:radial-gradient(ellipse 70% 40% at 50% 0%,rgba(255,77,109,.07) 0%,transparent 60%);}
#screen-results{background:radial-gradient(ellipse 80% 60% at 50% -10%,rgba(255,209,102,.09) 0%,transparent 70%);}
#screen-pick-q{background:radial-gradient(ellipse 60% 50% at 50% 0%,rgba(255,209,102,.07) 0%,transparent 60%);}
</style>
</head>
<body>

<div id="toast"></div>
<div id="loading"><div class="spinner"></div><div id="loading-text">Loading…</div></div>

<!-- CONFIRM OVERLAY -->
<div id="confirm-overlay" class="overlay">
  <div class="dialog-box" style="text-align:center;">
    <div style="font-size:2rem;margin-bottom:14px;">⚠️</div>
    <p id="confirm-msg" style="color:var(--off);line-height:1.6;margin-bottom:24px;font-size:.95rem;"></p>
    <div style="display:flex;gap:10px;justify-content:center;">
      <button class="btn btn-ghost" onclick="confirmCancel()">Cancel</button>
      <button class="btn btn-gold" id="confirm-ok">Confirm</button>
    </div>
  </div>
</div>

<!-- MEMBER EDITOR OVERLAY -->
<div id="member-overlay" class="overlay">
  <div class="dialog-box">
    <h3 id="member-title" style="margin-bottom:24px;font-size:1.1rem;">Add team member</h3>
    <div style="display:flex;flex-direction:column;align-items:center;gap:12px;margin-bottom:24px;">
      <div style="position:relative;cursor:pointer;" onclick="document.getElementById('photo-file').click()">
        <div id="modal-av" style="width:80px;height:80px;"></div>
        <div style="position:absolute;bottom:0;right:0;width:26px;height:26px;background:var(--coral);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.9rem;border:2px solid var(--card);">📷</div>
      </div>
      <input type="file" id="photo-file" accept="image/*" style="display:none" onchange="onPhotoFile(event)">
      <button id="photo-btn" onclick="document.getElementById('photo-file').click()" style="background:none;border:none;color:var(--muted);font-size:.8rem;cursor:pointer;text-decoration:underline;">Upload photo</button>
      <button id="rm-photo-btn" onclick="removePhoto()" style="display:none;background:none;border:none;color:var(--coral);font-size:.78rem;cursor:pointer;">Remove photo</button>
    </div>
    <div style="margin-bottom:20px;">
      <label style="display:block;font-size:.82rem;color:var(--muted);margin-bottom:6px;">Name</label>
      <input type="text" id="modal-name" placeholder="First name" maxlength="30" onkeydown="if(event.key==='Enter')saveMember()">
    </div>
    <div style="display:flex;gap:10px;">
      <button class="btn btn-ghost btn-block" onclick="closeMemberModal()">Cancel</button>
      <button class="btn btn-primary btn-block" onclick="saveMember()">Save</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: FIREBASE SETUP
══════════════════════════════════════════════════════════ -->
<div id="screen-firebase" class="screen active">
  <div class="centre">
    <div style="max-width:520px;width:100%;padding:20px;">
      <div style="font-size:3rem;margin-bottom:20px;">🔥</div>
      <div class="eyebrow">One-time setup</div>
      <h2 style="margin-bottom:8px;">Connect Real-Time Sync</h2>
      <p class="muted" style="margin-bottom:24px;line-height:1.7;">Takes 3 minutes. Firebase is free — this lets your whole team sync answers live across devices.</p>
      <div class="card" style="text-align:left;margin-bottom:20px;">
        <div style="display:flex;gap:14px;align-items:flex-start;padding:0 0 16px;border-bottom:1px solid rgba(255,255,255,.06);">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--coral);color:#fff;font-family:'Syne',sans-serif;font-weight:800;font-size:.85rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">1</div>
          <div><strong>Create a free Firebase project</strong><br><span class="muted" style="font-size:.85rem;">Go to <a href="https://console.firebase.google.com" target="_blank" style="color:var(--gold);">console.firebase.google.com</a> → Add project → any name → disable Analytics → Create</span></div>
        </div>
        <div style="display:flex;gap:14px;align-items:flex-start;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.06);">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--coral);color:#fff;font-family:'Syne',sans-serif;font-weight:800;font-size:.85rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">2</div>
          <div><strong>Add a Realtime Database</strong><br><span class="muted" style="font-size:.85rem;">Left menu → Build → Realtime Database → Create Database → choose any region → <em>Start in test mode</em></span></div>
        </div>
        <div style="display:flex;gap:14px;align-items:flex-start;padding:16px 0 0;">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--coral);color:#fff;font-family:'Syne',sans-serif;font-weight:800;font-size:.85rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">3</div>
          <div style="width:100%;"><strong>Paste your database URL below</strong><br><span class="muted" style="font-size:.85rem;">Looks like <code style="color:var(--gold);">https://your-project-default-rtdb.firebaseio.com</code></span>
            <input type="text" id="fb-url-input" placeholder="https://your-project-default-rtdb.firebaseio.com" style="margin-top:10px;" onkeydown="if(event.key==='Enter')saveFirebaseUrl()">
          </div>
        </div>
      </div>
      <button class="btn btn-gold btn-lg btn-block" onclick="saveFirebaseUrl()">Connect & Start Playing →</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: HOME
══════════════════════════════════════════════════════════ -->
<div id="screen-home" class="screen">
  <div class="centre">
    <div style="font-size:3.8rem;margin-bottom:20px;animation:float 3s ease-in-out infinite;">🎯</div>
    <div class="eyebrow">Case Team Fun</div>
    <h1 style="margin-bottom:14px;">Guess That <span style="color:var(--coral);">Thing</span></h1>
    <p class="muted" style="max-width:440px;margin-bottom:12px;">Everyone answers the same question anonymously. Can your team match the answer to the person?</p>
    <div id="home-roster-preview" style="display:flex;justify-content:center;margin-bottom:28px;min-height:44px;align-items:center;"></div>
    <div style="display:flex;flex-direction:column;gap:12px;align-items:center;">
      <button class="btn btn-primary btn-lg" onclick="goToCreate()">Host a New Game →</button>
      <button class="btn btn-outline" onclick="showScreen('screen-join')">Join a Game</button>
      <button class="btn btn-ghost" id="home-team-btn" onclick="showScreen('screen-team')">Set Up Your Team 👥</button>
    </div>
    <div style="margin-top:20px;">
      <button onclick="showScreen('screen-firebase')" style="background:none;border:none;color:var(--muted);font-size:.75rem;cursor:pointer;text-decoration:underline;" id="fb-status-btn">🔥 Firebase settings</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: TEAM
══════════════════════════════════════════════════════════ -->
<div id="screen-team" class="screen">
  <div class="topbar">
    <div class="logo">Guess That <span>Thing</span></div>
    <button class="btn btn-ghost btn-sm" onclick="showScreen('screen-home')">← Back</button>
  </div>
  <div class="wrap-sm" style="padding-top:32px;">
    <div class="eyebrow">Your Team</div>
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px;">
      <div><h2 style="margin-bottom:4px;">Team Roster</h2><p class="muted" style="font-size:.85rem;">Saved in your browser. Add photos for the best reveal moment.</p></div>
      <button class="btn btn-primary btn-sm" onclick="openMemberModal(null)">+ Add</button>
    </div>
    <div id="roster-list" style="display:flex;flex-direction:column;gap:10px;"></div>
    <div id="roster-empty" style="display:none;" class="card">
      <div style="text-align:center;padding:32px 0;">
        <div style="font-size:3rem;margin-bottom:12px;">👥</div>
        <p class="muted" style="margin-bottom:20px;">No team members yet.</p>
        <button class="btn btn-primary" onclick="openMemberModal(null)">Add First Person</button>
      </div>
    </div>
    <div style="margin-top:24px;"><button class="btn btn-gold btn-lg btn-block" onclick="showScreen('screen-home')">Done →</button></div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: CREATE
══════════════════════════════════════════════════════════ -->
<div id="screen-create" class="screen">
  <div class="topbar">
    <div class="logo">Guess That <span>Thing</span></div>
    <button class="btn btn-ghost btn-sm" onclick="showScreen('screen-home')">← Back</button>
  </div>
  <div class="wrap-sm" style="padding-top:36px;">
    <div class="eyebrow">New Game</div>
    <h2 style="margin-bottom:6px;">Who's playing today?</h2>
    <p class="muted" style="margin-bottom:24px;">Select everyone who's in — tap to toggle.</p>
    <div id="create-empty" style="display:none;" class="card" style="text-align:center;padding:40px 24px;margin-bottom:20px;">
      <p class="muted" style="margin-bottom:16px;">Add your team first.</p>
      <button class="btn btn-primary" onclick="showScreen('screen-team')">Set Up Team</button>
    </div>
    <div id="create-controls" style="display:none;">
      <div style="display:flex;gap:8px;margin-bottom:16px;">
        <button class="btn btn-ghost btn-sm" onclick="selAll()">Select All</button>
        <button class="btn btn-ghost btn-sm" onclick="selNone()">Clear</button>
        <button class="btn btn-ghost btn-sm" onclick="showScreen('screen-team')">✏️ Edit Team</button>
      </div>
      <div id="create-grid" class="player-grid" style="margin-bottom:24px;"></div>
      <button class="btn btn-gold btn-lg btn-block" id="create-btn" onclick="proceedToQuestion()" disabled>Select at least 2 players</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: PICK QUESTION
══════════════════════════════════════════════════════════ -->
<div id="screen-pick-q" class="screen">
  <div class="topbar">
    <div class="logo">Guess That <span>Thing</span></div>
    <button class="btn btn-ghost btn-sm" onclick="showScreen('screen-create')">← Back</button>
  </div>
  <div class="wrap-sm" style="padding-top:32px;">
    <div class="eyebrow">Pick a Question</div>
    <h2 style="margin-bottom:6px;">What are we guessing today?</h2>
    <p class="muted" style="margin-bottom:24px;">Choose from the list, or write your own.</p>

    <!-- Write your own -->
    <div class="card" style="margin-bottom:20px;">
      <h3 style="margin-bottom:10px;font-size:.95rem;">✏️ Write your own</h3>
      <textarea id="custom-q-input" rows="2" placeholder="Type a custom question…" style="font-size:.95rem;margin-bottom:10px;"></textarea>
      <button class="btn btn-primary btn-sm" onclick="useCustomQuestion()">Use This Question →</button>
    </div>

    <!-- Shuffle for fresh options -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <span style="font-weight:600;font-size:.88rem;">Or pick from the list</span>
      <button class="btn btn-ghost btn-sm" onclick="shuffleQuestionList()">🔀 Shuffle</button>
    </div>
    <div id="q-option-list" style="display:flex;flex-direction:column;gap:8px;"></div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: JOIN
══════════════════════════════════════════════════════════ -->
<div id="screen-join" class="screen">
  <div class="topbar">
    <div class="logo">Guess That <span>Thing</span></div>
    <button class="btn btn-ghost btn-sm" onclick="showScreen('screen-home')">← Back</button>
  </div>
  <div class="centre">
    <div style="max-width:400px;width:100%;padding:20px;">
      <div style="font-size:3rem;margin-bottom:20px;">🚪</div>
      <div class="eyebrow">Join a Game</div>
      <h2 style="margin-bottom:24px;">Enter the room code</h2>
      <input type="text" id="join-code" placeholder="e.g. GTT-4K2" maxlength="8"
        style="text-align:center;font-size:1.4rem;font-family:'Syne',sans-serif;font-weight:700;letter-spacing:.15em;text-transform:uppercase;margin-bottom:16px;"
        oninput="this.value=this.value.toUpperCase()" onkeydown="if(event.key==='Enter')joinRoom()">
      <button class="btn btn-primary btn-lg btn-block" onclick="joinRoom()">Join →</button>
      <p class="muted" style="font-size:.8rem;margin-top:16px;">Ask your host for the room code.</p>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     SCREEN: WAITING / LOBBY
══════════════════════════════════════════════════════════ -->
<div id="screen-waiting" class="screen">
  <div class="topbar">
    <div class="logo">Guess That <span>Thing</span></div>
    <div id="waiting-top-right" style="display:flex;align-items:center;gap:10px;"></div>
  </div>
  <div class="wrap-md" style="padding-top:28px;">

    <!-- Room code -->
    <div style="margin-bottom:20px;text-align:center;">
      <p class="muted" style="font-size:.8rem;margin-bottom:8px;">Share this code — teammates open the file and tap "Join a Game"</p>
      <div class="room-code-box" id="room-code-display" onclick="copyRoomCode()"></div>
      <p style="font-size:.72rem;color:var(--muted);margin-top:6px;">👆 tap to copy</p>
    </div>

    <!-- Question -->
    <div class="card" style="margin-bottom:20px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;gap:12px;">
        <div class="eyebrow">🎯 Today's Question</div>
