// ═══════════════════════════════════════════════════════════
function handleGuessClick(){
  const miss=activePlayers.length-Object.keys(submissions).length;
  if(miss>0)showConfirm(`${miss} player${miss>1?"s haven't":" hasn't"} submitted yet. Start anyway?`,startGuessing);
  else startGuessing();
}
function startGuessing(){
  stopAll();
  cards=shuffle(activePlayers.filter(p=>submissions[p.id]).map(p=>({...submissions[p.id],name:p.name,playerId:p.id,person:p})));
  document.getElementById('guessing-q').textContent=`"${question}"`;
  renderCards(false);
  showScreen('screen-guessing');
}
